          "settings": {
            "html": "<div style=\"max-width:1100px;margin:0 auto;\"><div style=\"margin-bottom:32px;\"><span class=\"mbr-eyebrow\">Inside the plugin</span><h2 class=\"mbr-heading-section\">See what you&rsquo;re getting</h2></div><div class=\"mbr-grid-3\"><div class=\"mbr-glass\" style=\"overflow:hidden;padding:0;\"><div style=\"height:180px;background:linear-gradient(135deg,#1a1f3d 0%,#2a1d4d 100%);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.22);font-size:42px;\"><i class=\"fas fa-tachometer-alt\" aria-hidden=\"true\"></i></div><div style=\"padding:14px 16px;\"><p style=\"margin:0;font-size:13px;font-weight:500;color:#fff;\">Dashboard overview</p><p class=\"mbr-text-faint\" style=\"margin:3px 0 0;font-size:12px;\">At-a-glance status</p></div></div><div class=\"mbr-glass\" style=\"overflow:hidden;padding:0;\"><div style=\"height:180px;background:linear-gradient(135deg,#1f2a4d 0%,#1a4d3a 100%);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.22);font-size:42px;\"><i class=\"fas fa-image\" aria-hidden=\"true\"></i></div><div style=\"padding:14px 16px;\"><p style=\"margin:0;font-size:13px;font-weight:500;color:#fff;\">Image &amp; WebP tools</p><p class=\"mbr-text-faint\" style=\"margin:3px 0 0;font-size:12px;\">Bulk converter, resizer</p></div></div><div class=\"mbr-glass\" style=\"overflow:hidden;padding:0;\"><div style=\"height:180px;background:linear-gradient(135deg,#3a2a1d 0%,#1f2a4d 100%);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.22);font-size:42px;\"><i class=\"fas fa-database\" aria-hidden=\"true\"></i></div><div style=\"padding:14px 16px;\"><p style=\"margin:0;font-size:13px;font-weight:500;color:#fff;\">Database panel</p><p class=\"mbr-text-faint\" style=\"margin:3px 0 0;font-size:12px;\">Cleanup &amp; optimisation</p></div></div></div></div>"
