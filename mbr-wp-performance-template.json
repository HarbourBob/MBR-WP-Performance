          "widgetType": "html",
          "settings": {
            "html": "<div style=\"max-width:1100px;margin:0 auto;\"><div class=\"mbr-trust-strip\"><span><i class=\"fas fa-shield-alt\" style=\"color:#5DCAA5;font-size:14px;\" aria-hidden=\"true\"></i> Security-first</span><span><i class=\"fas fa-eye-slash\" style=\"color:#85B7EB;font-size:14px;\" aria-hidden=\"true\"></i> Privacy by design</span><span><i class=\"fas fa-gift\" style=\"color:#FAC775;font-size:14px;\" aria-hidden=\"true\"></i> No upsells, ever</span><span><i class=\"fas fa-code\" style=\"color:#F0997B;font-size:14px;\" aria-hidden=\"true\"></i> Open source on GitHub</span><span><i class=\"fas fa-network-wired\" style=\"color:#AFA9EC;font-size:14px;\" aria-hidden=\"true\"></i> Multisite-ready</span></div></div>"
